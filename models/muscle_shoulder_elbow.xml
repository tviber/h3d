<mujoco model="h3d_muscle_shoulder_elbow">
  <compiler angle="radian" inertiafromgeom="false" autolimits="true"/>
  <option timestep="0.0005" integrator="RK4" gravity="0 0 -9.81">
    <flag contact="disable" energy="enable"/>
  </option>
  <default>
    <joint type="hinge" axis="0 0 1" damping="0.08" armature="0.002"/>
    <geom contype="0" conaffinity="0" rgba="0.74 0.53 0.42 1"/>
    <site size="0.008" rgba="0.9 0.2 0.15 1"/>
    <motor ctrlrange="-1 1" ctrllimited="true"/>
  </default>
  <worldbody>
    <body name="torso" pos="0 -0.19 1.436">
      <site name="biceps_origin" pos="0.035 -0.075 0"/>
      <site name="triceps_origin" pos="-0.04 -0.075 0"/>
      <site name="deltoid_origin" pos="-0.06 -0.09 0"/>
      <body name="upper_arm">
        <joint name="shoulder_flex" range="-1.396 2.094"/>
        <inertial pos="0 -0.141 0" mass="2.033" diaginertia="0.0131 0.0117 0.0040"/>
        <geom name="upper_arm_visual" type="capsule" fromto="0 0 0 0 -0.282 0" size="0.045"/>
        <site name="shoulder"/>
        <site name="biceps_guide" pos="0.035 -0.18 0"/>
        <site name="triceps_guide" pos="-0.04 -0.18 0"/>
        <site name="deltoid_insertion" pos="-0.035 -0.19 0"/>
        <site name="brachialis_origin" pos="0.04 -0.16 0"/>
        <site name="brachialis_side" pos="0.055 -0.282 0"/>
        <site name="triceps_side" pos="-0.055 -0.282 0"/>
        <geom name="brachialis_wrap" type="cylinder" pos="0 -0.282 0" zaxis="0 0 1" size="0.019 0.035" rgba="0.8 0.4 0.2 0.35"/>
        <geom name="triceps_wrap" type="cylinder" pos="0 -0.282 0" zaxis="0 0 1" size="0.019 0.035" rgba="0.2 0.4 0.8 0.25"/>
        <body name="forearm" pos="0 -0.282 0">
          <joint name="elbow_flex" range="0 2.53"/>
          <inertial pos="0 -0.1345 0" mass="1.215" diaginertia="0.0067 0.0062 0.0013"/>
          <geom name="forearm_visual" type="capsule" fromto="0 0 0 0 -0.269 0" size="0.035" rgba="0.86 0.68 0.56 1"/>
          <site name="elbow"/>
          <site name="wrist" pos="0 -0.269 0" rgba="0.2 0.4 0.9 1"/>
          <site name="biceps_insertion" pos="0.03 -0.05 0"/>
          <site name="triceps_insertion" pos="-0.03 -0.05 0"/>
          <site name="brachialis_insertion" pos="0.03 -0.04 0"/>
        </body>
      </body>
    </body>
  </worldbody>
  <tendon>
    <spatial name="biceps_long_head" width="0.012" rgba="0.9 0.25 0.15 1">
      <site site="biceps_origin"/><site site="biceps_guide"/><site site="biceps_insertion"/>
    </spatial>
    <spatial name="triceps_long_head" width="0.012" rgba="0.2 0.4 0.9 1">
      <site site="triceps_origin"/><site site="triceps_guide"/><site site="triceps_insertion"/>
    </spatial>
    <spatial name="brachialis" width="0.010" rgba="0.95 0.55 0.15 1">
      <site site="brachialis_origin"/>
      <geom geom="brachialis_wrap" sidesite="brachialis_side"/>
      <site site="brachialis_insertion"/>
    </spatial>
    <spatial name="posterior_deltoid" width="0.010" rgba="0.25 0.75 0.4 1">
      <site site="deltoid_origin"/><site site="deltoid_insertion"/>
    </spatial>
  </tendon>
  <actuator>
    <motor name="shoulder_flex" joint="shoulder_flex" gear="100"/>
    <motor name="elbow_flex" joint="elbow_flex" gear="70"/>
  </actuator>
</mujoco>
