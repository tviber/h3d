      "duration": 0.85,
      "initialPoseRad": { "elbow_flex": 0.55 },
      "muscles": [
        { "name": "biceps", "tendon": "biceps", "maxIsometricForce": 700, "optimalFiberLength": 0.12, "tendonSlackLength": 0.042, "maxContractionVelocity": 10, "activationTimeConstant": 0.015, "deactivationTimeConstant": 0.05 },
        { "name": "triceps", "tendon": "triceps", "maxIsometricForce": 850, "optimalFiberLength": 0.12, "tendonSlackLength": 0.042, "maxContractionVelocity": 10, "activationTimeConstant": 0.015, "deactivationTimeConstant": 0.05 }
