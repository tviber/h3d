      "controllers": [
        { "muscle": "biceps", "baseline": 0.02, "pulses": [{ "muscle": "biceps", "level": 0.65, "start": 0.08, "duration": 0.38, "riseTime": 0.08 }] },
        { "muscle": "triceps", "baseline": 0.02, "pulses": [{ "muscle": "triceps", "level": 0.34, "start": 0.43, "duration": 0.28, "riseTime": 0.07 }] }
      ],
      "rig": { "kind": "elbow" }
    },
