{
  "name": "h3d",
  "version": "0.0.1",
  "description": "Human multibody dynamics simulator: torque-driven pelvis/trunk/arm/racket kinetic chain on MuJoCo",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "h3d": "node src/cli.ts",
    "muscles": "node src/muscle-cli.ts",
    "web": "node src/web-server.ts",
    "poses": "node scripts/export-basic-motions.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "smoke": "node src/cli.ts compare --out out/smoke --duration 0.6 --no-png"
  },
  "dependencies": {
    "@mujoco/mujoco": "3.17.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/three": "^0.180.0",
    "typescript": "5.9.3"
  }
}
